# Copy this file to .env and fill in the values.
# .env is gitignored and never committed.

# Secret of the confidential Keycloak client "trading-bff". Generated by Keycloak, exposed by Terraform.
# From the trading-infra repo (after sourcing its .env), in terraform/keycloak/envs/dev:
#   terraform output -raw bff_client_secret
# Required: the BFF refuses to start without it.
BFF_CLIENT_SECRET=

# Profile "secure-file" (SPRING_PROFILES_ACTIVE=secure-file): BFF_CLIENT_SECRET is then the secret of the client
# "secure-file-bff". From trading-infra, in terraform/keycloak/envs/secure-file-dev:
#   terraform output -raw bff_client_secret
# SECURE_FILE_URI=http://localhost:8082
# KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/secure-file

# Optional overrides (defaults in application.properties are the local dev values)
# KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/trading
# TRADING_CORE_URI=http://localhost:8080
# FRONTEND_URL=http://localhost:5173
# REDIS_HOST=localhost
# REDIS_PORT=6379